    {"section": 12, "subsection": null, "owner": "self", "entity_name": null, "description": "Personal travel from Melbourne to Canberra in return from a wedding on 20/2/11. The pilot on the booked economy flight died so the flight was cancelled. I was upgraded to business to fit on the subsequent flight.", "location": null, "purpose": null, "is_alteration": true, "change_type": "added", "lodged_date": "2011-03-21", "date_precision": "day", "page": 9, "confidence": "high"},
