    {"section": 12, "subsection": null, "owner": "self", "entity_name": "Qantas", "description": "On 27 December 2011, my husband Chris Uhlmann and I were upgraded from Economy to Business Class on a return flight QF856 from Melbourne to Canberra. The travel was for personal reasons. The upgrade was not requested.", "location": null, "purpose": null, "is_alteration": true, "change_type": "added", "lodged_date": "2012-01-29", "date_precision": "day", "page": 10, "confidence": "medium"},
    {"section": 12, "subsection": null, "owner": "spouse", "entity_name": "Qantas", "description": "On 27 December 2011, my husband Chris Uhlmann and I were upgraded from Economy to Business Class on a return flight QF856 from Melbourne to Canberra. The travel was for personal reasons. The upgrade was not requested.", "location": null, "purpose": null, "is_alteration": true, "change_type": "added", "lodged_date": "2012-01-29", "date_precision": "day", "page": 10, "confidence": "medium"},
    {"section": 12, "subsection": null, "owner": "self", "entity_name": null, "description": "On 10 August my husband and I were travelling from Canberra to Melbourne for my mother's birthday. We had booked economy flights. Unfortunately our flight was cancelled and, as the subsequent flight was full, we were upgraded to business class. We did not request an upgrade.", "location": null, "purpose": null, "is_alteration": true, "change_type": "added", "lodged_date": "2012-09-10", "date_precision": "day", "page": 12, "confidence": "medium"},
